            <!-- NEW: DT-015 FIBRA BLINDADA -->
            <a href="DT-SICC-2026-015_Blindaje_Fibra_Backbone.html" class="rule-card" style="border-color: #10b981;">
                <div class="rule-tag">DT-SICC-2026-015</div>
                <div class="rule-title">Blindaje Backbone: Fibra G.652.D</div>
                <div class="rule-summary">Homogeneización a 100% G.652.D y fijación de capacidad a 48 hilos. Eliminación de riesgos de atenuación y OPEX de doble inventario.</div>
                
                <div class="rule-impact">
